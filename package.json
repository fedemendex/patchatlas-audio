{
  "name": "patchatlas-audio",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "description": "A dependency-free Web Audio engine for modular-synth-style patches: describe a patch as plain JSON, run it in a single AudioWorklet.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worklet.js": "./dist/worklet.js"
  },
  "files": [
    "dist",
    "docs"
  ],
  "workspaces": [
    "examples/playground"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsdown && node scripts/verify-worklet-bundle.mjs dist/worklet.js",
    "smoke": "node scripts/smoke.mjs",
    "dev": "tsdown --watch"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9"
  }
}
